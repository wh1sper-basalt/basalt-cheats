### Basalt Cheats (local)
# Copy to .env if you want to store local settings outside git.
#
# This project can run in XAMPP without env-vars. The file exists
# mainly for Docker/GitHub completeness and future extensions.

DB_HOST=127.0.0.1
DB_PORT=3306
DB_NAME=basalt_cheats
DB_USER=root
DB_PASS=

# Base path if you open via http://localhost/<folder>
WEB_BASE=
